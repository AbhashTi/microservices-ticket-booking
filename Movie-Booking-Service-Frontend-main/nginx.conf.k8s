server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # CoreDNS resolver for Kubernetes
  resolver kube-dns.kube-system.svc.cluster.local valid=10s ipv6=off;
  set $api_gateway api-gateway.movie-app.svc.cluster.local;

  # /auth — NO trailing slash, matches /auth/signup /auth/signin /auth/anything
  location /auth {
    proxy_pass http://$api_gateway:8085;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 30s;
  }

  # /matches — covers /matches, /matches/1, /matches/1/sessions
  location /matches {
    proxy_pass http://$api_gateway:8085;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 30s;
  }

  # /sessions — covers /sessions/1, /sessions/1/seats/status
  location /sessions {
    proxy_pass http://$api_gateway:8085;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 30s;
  }

  # /bookings — covers /bookings/create /bookings/my /bookings/show/:id/seats/status
  location /bookings {
    proxy_pass http://$api_gateway:8085;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 30s;
  }

  # /payment — covers /payment/pay
  location /payment {
    proxy_pass http://$api_gateway:8085;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 30s;
  }

  # NOTE: /users/login and /users/signup and /users/bookings are React Router paths
  # They must NOT be proxied to api-gateway — they must be served as index.html
  # so React Router handles them client-side. That is what location / does below.

  # Static assets — long cache
  location /static/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Everything else — React SPA (handles /users/login, /users/signup, /users/bookings,
  # /bookmyshow/matches, /bookmyshow/seat-layout/*, /bookmyshow/payment/*, etc.)
  location / {
    try_files $uri $uri/ /index.html;
  }
}
