// ============================================================
// Frontend Pipeline – Stadium Ticket Booking System
// npm install → React build → Docker build → Push → Restart container
// ============================================================
pipeline {
    agent any
    options { timestamps() }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: "build-${env.BUILD_NUMBER}",
            description: 'Docker image tag'
        )
        booleanParam(
            name: 'DEPLOY_K8S',
            defaultValue: false,
            description: 'Also deploy to Minikube K8s?'
        )
    }

    environment {
        SERVICE_NAME  = 'match-frontend'
        DOCKER_REPO   = 'abhashti'
        K8S_NAMESPACE = 'movie-app'
        FRONTEND_DIR  = "${WORKSPACE}/Movie-Booking-Service-Frontend-main"
        NODE_VERSION  = '18'

        // ✅ FIX: macOS kubectl paths — tries Homebrew (Apple Silicon & Intel) then fallback
        KUBECTL = sh(
            script: '''
                if [ -f /opt/homebrew/bin/kubectl ]; then
                    echo /opt/homebrew/bin/kubectl
                elif [ -f /usr/local/bin/kubectl ]; then
                    echo /usr/local/bin/kubectl
                else
                    echo kubectl
                fi
            ''',
            returnStdout: true
        ).trim()

        // ✅ FIX: Ensure Homebrew bin dirs are always on PATH for all sh steps
        PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ✅ FIX: Verify kubectl & minikube are reachable before any deploy attempt
        stage('Verify Tools') {
            steps {
                sh '''
                    echo "=== PATH ==="
                    echo "$PATH"

                    echo "=== kubectl ==="
                    which kubectl || echo "kubectl NOT FOUND"
                    kubectl version --client 2>/dev/null || echo "kubectl not working"

                    echo "=== minikube ==="
                    which minikube || echo "minikube NOT FOUND"
                    minikube version 2>/dev/null || echo "minikube not working"

                    echo "=== docker ==="
                    docker --version || echo "docker NOT FOUND"
                '''
            }
        }

        stage('Install Depends') {
            steps {
                dir("${env.FRONTEND_DIR}") {
                    sh '''
                        export NVM_DIR="$HOME/.nvm"
                        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                        nvm use 18
                        rm -rf build node_modules package-lock.json
                        npm install --legacy-peer-deps
                        npm install ajv@^8.0.0 --save-dev --legacy-peer-deps
                        node -v && npm -v
                    '''
                }
            }
        }

        stage('Build React App') {
            steps {
                dir("${env.FRONTEND_DIR}") {
                    sh '''
                        export NVM_DIR="$HOME/.nvm"
                        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                        nvm use 18
                        CI=false npm run build
                        # Remove any hardcoded VM IPs from compiled output
                        # ✅ FIX: macOS sed requires '' after -i (unlike Linux)
                        find build/static/js -name "*.js" -exec sed -i '' 's|http://172.16.180.127:8085||g' {} +
                    '''
                    echo "React build complete"
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def imageTag = params.IMAGE_TAG ?: "build-${env.BUILD_NUMBER}"
                    env.IMAGE_NAME = "${env.DOCKER_REPO}/${env.SERVICE_NAME}:${imageTag}"
                }
                dir("${env.FRONTEND_DIR}") {
                    echo "Building Docker image: ${env.IMAGE_NAME}"
                    sh "docker build -t ${env.IMAGE_NAME} ."
                }
            }
        }

        stage('Docker Push') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$IMAGE_NAME"
                    '''
                }
            }
        }

        stage('Restart Frontend Container') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            steps {
                echo "Restarting frontend container..."
                sh '''
                    docker stop frontend-app-container 2>/dev/null || true
                    docker rm   frontend-app-container 2>/dev/null || true
                    docker run -d \
                        --name frontend-app-container \
                        --network movie-booking-system-microservices_movie-net \
                        -p 80:80 \
                        "$IMAGE_NAME"
                    echo "=== Frontend container status ==="
                    docker ps | grep frontend-app-container
                '''
            }
        }

        // ✅ FIX: Full minikube + kubectl setup for macOS before deploying
        stage('Deploy to Minikube (Optional)') {
            when {
                allOf {
                    expression { currentBuild.currentResult == 'SUCCESS' }
                    expression { params.DEPLOY_K8S == true }
                }
            }
            steps {
                sh """
                    export PATH="/opt/homebrew/bin:/usr/local/bin:\$PATH"

                    # ✅ Install kubectl via Homebrew if missing
                    if ! command -v kubectl &>/dev/null; then
                        echo "kubectl not found — installing via Homebrew..."
                        brew install kubectl
                    fi

                    # ✅ Install minikube via Homebrew if missing
                    if ! command -v minikube &>/dev/null; then
                        echo "minikube not found — installing via Homebrew..."
                        brew install minikube
                    fi

                    # ✅ Start minikube if it is not already running
                    MINIKUBE_STATUS=\$(minikube status --format='{{.Host}}' 2>/dev/null || echo "Stopped")
                    if [ "\$MINIKUBE_STATUS" != "Running" ]; then
                        echo "Starting minikube..."
                        minikube start --driver=docker
                    else
                        echo "Minikube already running"
                    fi

                    # ✅ Make sure kubectl context points to minikube
                    kubectl config use-context minikube

                    # ✅ FIX 1: Load the locally built Docker image directly into Minikube
                    # This avoids Minikube trying to pull from Docker Hub and getting stuck
                    echo "Loading image into Minikube: ${env.IMAGE_NAME}"
                    minikube image load ${env.IMAGE_NAME}
                    echo "Image loaded successfully into Minikube"

                    # Create namespace
                    kubectl create namespace ${env.K8S_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

                    # ✅ FIX 2: Patch the YAML — set image AND change imagePullPolicy to Never
                    # so Minikube uses the locally loaded image instead of pulling from Docker Hub
                    sed \
                        -e 's|image: .*|image: ${env.IMAGE_NAME}|g' \
                        -e 's|imagePullPolicy: Always|imagePullPolicy: Never|g' \
                        ${env.FRONTEND_DIR}/k8s/frontend-deployment.yaml | \
                        kubectl apply -f - -n ${env.K8S_NAMESPACE}

                    kubectl apply -f ${env.FRONTEND_DIR}/k8s/frontend-service.yaml \
                        -n ${env.K8S_NAMESPACE}

                    # Update image on existing deployment
                    kubectl set image deployment/${env.SERVICE_NAME} \
                        ${env.SERVICE_NAME}=${env.IMAGE_NAME} \
                        -n ${env.K8S_NAMESPACE}

                    # ✅ FIX 3: Increase timeout to 5 minutes — image load + pod start takes time
                    kubectl rollout status deployment/${env.SERVICE_NAME} \
                        -n ${env.K8S_NAMESPACE} --timeout=300s

                    echo "=== Pod status ==="
                    kubectl get pods -n ${env.K8S_NAMESPACE}

                    echo "=== Service status ==="
                    kubectl get svc -n ${env.K8S_NAMESPACE}
                """
            }
        }
    }

    post {
        success {
            echo "Frontend pipeline SUCCESS (Build #${env.BUILD_NUMBER})"
            echo "UI live at: http://localhost:80"
            echo "Image: ${env.IMAGE_NAME}"
        }
        failure {
            echo "Frontend pipeline FAILED at Build #${env.BUILD_NUMBER}"
        }
    }
}
