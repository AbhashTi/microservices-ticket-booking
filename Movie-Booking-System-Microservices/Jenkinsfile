// ============================================================
// Backend Pipeline – Stadium Ticket Booking System
// Builds all microservices → Docker rebuild → Ansible Deploy → Live
// ============================================================
pipeline {
    agent any
    options { timestamps() }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: "build-${env.BUILD_NUMBER}",
            description: 'Docker image tag for all services'
        )
        booleanParam(
            name: 'DEPLOY_K8S',
            defaultValue: false,
            description: 'Also deploy to Minikube after Ansible deploy?'
        )
    }

    environment {
        DOCKER_REPO   = 'abhashti'
        K8S_NAMESPACE = 'movie-app'
        BACKEND_DIR   = "${WORKSPACE}/Movie-Booking-System-Microservices"
        SERVICES      = 'discovery-server,api-gateway,user-service,match-service,booking-service,payment-service,notification-service'

        // ✅ FIX: macOS kubectl paths — tries Homebrew (Apple Silicon & Intel) then fallback
        KUBECTL = sh(
            script: '''
                if [ -f /opt/homebrew/bin/kubectl ]; then
                    echo /opt/homebrew/bin/kubectl
                elif [ -f /usr/local/bin/kubectl ]; then
                    echo /usr/local/bin/kubectl
                else
                    echo kubectl
                fi
            ''',
            returnStdout: true
        ).trim()

        // ✅ FIX: Ensure Homebrew bin dirs are always on PATH for all sh steps
        PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ✅ FIX: Verify all required tools are reachable on this macOS agent
        stage('Verify Tools') {
            steps {
                sh '''
                    echo "=== PATH ==="
                    echo "$PATH"

                    echo "=== kubectl ==="
                    which kubectl || echo "kubectl NOT FOUND"
                    kubectl version --client 2>/dev/null || echo "kubectl not working"

                    echo "=== minikube ==="
                    which minikube || echo "minikube NOT FOUND"
                    minikube version 2>/dev/null || echo "minikube not working"

                    echo "=== ansible ==="
                    which ansible-playbook || echo "ansible-playbook NOT FOUND"
                    ansible --version 2>/dev/null || echo "ansible not working"

                    echo "=== docker ==="
                    docker --version || echo "docker NOT FOUND"

                    echo "=== java / mvn ==="
                    java -version 2>&1 || echo "java NOT FOUND"
                    mvn -version 2>/dev/null || echo "mvn NOT FOUND"
                '''
            }
        }

        stage('Build All Microservices') {
            steps {
                script {
                    def serviceList = env.SERVICES.split(',')
                    serviceList.each { svc ->
                        dir("${env.BACKEND_DIR}/${svc}") {
                            echo "===== Building ${svc} ====="
                            sh '''
                                chmod +x mvnw 2>/dev/null || true
                                if [ -f ./mvnw ]; then
                                    ./mvnw -B clean package -DskipTests -q
                                else
                                    mvn -B clean package -DskipTests -q
                                fi
                            '''
                            echo "===== ${svc} DONE ====="
                        }
                    }
                }
            }
        }

        stage('Docker Build All') {
            steps {
                script {
                    def imageTag = params.IMAGE_TAG ?: "build-${env.BUILD_NUMBER}"
                    env.IMAGE_TAG_FINAL = imageTag
                    def serviceList = env.SERVICES.split(',')
                    serviceList.each { svc ->
                        dir("${env.BACKEND_DIR}/${svc}") {
                            def imageName = "${env.DOCKER_REPO}/${svc}:${imageTag}"
                            echo "Building Docker image: ${imageName}"
                            sh "docker build -t ${imageName} ."
                        }
                    }
                }
            }
        }

        stage('Docker Push All') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    script {
                        sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                        def serviceList = env.SERVICES.split(',')
                        serviceList.each { svc ->
                            def imageName = "${env.DOCKER_REPO}/${svc}:${env.IMAGE_TAG_FINAL}"
                            echo "Pushing ${imageName}..."
                            sh "docker push ${imageName}"
                        }
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════
        // ANSIBLE STAGE — pulls images & deploys full stack
        // ══════════════════════════════════════════════════
        stage('Ansible Deploy') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            steps {
                echo "Running Ansible playbook to deploy all services..."
                sh '''
                    export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

                    # ✅ FIX: Install ansible via Homebrew if not present (macOS)
                    if ! command -v ansible-playbook &>/dev/null; then
                        echo "Ansible not found — installing via Homebrew..."
                        brew install ansible
                    fi
                    ansible --version
                '''
                dir("${env.BACKEND_DIR}") {
                    // ✅ FIX: Use WORKSPACE-relative paths instead of hardcoded /Users/abhashtiwari
                    sh """
                        export PATH="/opt/homebrew/bin:/usr/local/bin:\$PATH"
                        ansible-playbook \\
                            -i ${env.BACKEND_DIR}/ansible/inventory.ini \\
                            ${env.BACKEND_DIR}/ansible/deploy.yml \\
                            -e "image_tag=${env.IMAGE_TAG_FINAL}" \\
                            -v
                    """
                }
            }
        }

        // ✅ FIX: Full minikube + kubectl setup for macOS before deploying
        stage('Deploy to Minikube (Optional)') {
            when {
                allOf {
                    expression { currentBuild.currentResult == 'SUCCESS' }
                    expression { params.DEPLOY_K8S == true }
                }
            }
            steps {
                script {
                    sh """
                        export PATH="/opt/homebrew/bin:/usr/local/bin:\$PATH"

                        # ✅ Install kubectl via Homebrew if missing
                        if ! command -v kubectl &>/dev/null; then
                            echo "kubectl not found — installing via Homebrew..."
                            brew install kubectl
                        fi

                        # ✅ Install minikube via Homebrew if missing
                        if ! command -v minikube &>/dev/null; then
                            echo "minikube not found — installing via Homebrew..."
                            brew install minikube
                        fi

                        # ✅ Start minikube if it is not already running
                        MINIKUBE_STATUS=\$(minikube status --format='{{.Host}}' 2>/dev/null || echo "Stopped")
                        if [ "\$MINIKUBE_STATUS" != "Running" ]; then
                            echo "Starting minikube..."
                            minikube start --driver=docker
                        else
                            echo "Minikube already running"
                        fi

                        # ✅ Make sure kubectl context points to minikube
                        kubectl config use-context minikube

                        # Create namespace
                        kubectl create namespace ${env.K8S_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
                    """

                    def serviceList = env.SERVICES.split(',')
                    serviceList.each { svc ->
                        def imageName = "${env.DOCKER_REPO}/${svc}:${env.IMAGE_TAG_FINAL}"
                        sh """
                            export PATH="/opt/homebrew/bin:/usr/local/bin:\$PATH"
                            kubectl set image deployment/${svc} ${svc}=${imageName} \
                                -n ${env.K8S_NAMESPACE} 2>/dev/null || \
                            echo "Deployment ${svc} not found in K8s – skipping"
                        """
                    }

                    serviceList.each { svc ->
                        sh """
                            export PATH="/opt/homebrew/bin:/usr/local/bin:\$PATH"
                            kubectl rollout status deployment/${svc} \
                                -n ${env.K8S_NAMESPACE} --timeout=120s 2>/dev/null || \
                            echo "Rollout for ${svc} not found – skipping"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Backend pipeline SUCCESS (Build #${env.BUILD_NUMBER})"
            echo "App running at: http://localhost:80"
            echo "API Gateway at: http://localhost:8085"
            echo "Eureka at:      http://localhost:8761"
        }
        failure {
            echo "Backend pipeline FAILED at Build #${env.BUILD_NUMBER}"
        }
    }
}
